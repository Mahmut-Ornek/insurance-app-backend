<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="mahmut">
        <createTable tableName="product">
            <column name="product_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="price" type="decimal(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="mahmut">
        <dropUniqueConstraint tableName="product" constraintName="name"/>
    </changeSet>

    <changeSet id="3" author="mahmut">
        <dropColumn tableName="product" columnName="price"/>
    </changeSet>

    <changeSet id="4" author="mahmut">
        <addColumn tableName="product">
            <column name="is_deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    
    <changeSet id="5" author="mahmut">
        <addColumn tableName="product">
            <column name="description" type="varchar(500)">
                <constraints nullable="true"/>
            </column>

            <column name="created_by" type="varchar(150)">
                <constraints nullable="true"/>
            </column>

            <column name="create_date" type="date">
                <constraints nullable="true"/>
            </column>

            <column name="updated_by" type="varchar(150)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>