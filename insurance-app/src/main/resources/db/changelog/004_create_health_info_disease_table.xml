<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="mahmut">
        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="health_info_disease"/>
            </not>
            <tableExists tableName="health_info"/>
            <columnExists tableName="health_info" columnName="health_id"/>
            <tableExists tableName="disease"/>
            <columnExists tableName="disease" columnName="id"/>
        </preConditions>

        <createTable tableName="health_info_disease">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="health_info_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_health_info_disease_health_info"
                             references="health_info(health_id)"/>
            </column>

            <column name="disease_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_health_info_disease_disease"
                             references="disease(id)"/>
            </column>

            <column name="diagnosis_date" type="date">
                <constraints nullable="false"/>
            </column>

            <column name="details" type="varchar(500)">
                <constraints nullable="true"/>
            </column>

            <column name="is_deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="mahmut">
        <createIndex indexName="idx_hid_health_info_id" tableName="health_info_disease">
            <column name="health_info_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="3" author="mahmut">
        <createIndex indexName="idx_hid_disease_id" tableName="health_info_disease">
            <column name="disease_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>