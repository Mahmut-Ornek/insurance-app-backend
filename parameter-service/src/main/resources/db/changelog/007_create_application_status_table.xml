<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="mahmut">
        <createTable tableName="application_status">
            <column name="code" type="varchar(1)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="varchar(255)"/>
        </createTable>

        <insert tableName="application_status">
            <column name="code" value="P"/>
            <column name="name" value="PENDING"/>
            <column name="description" value="Başvuru değerlendirmede"/>
        </insert>
        <insert tableName="application_status">
            <column name="code" value="A"/>
            <column name="name" value="APPROVED"/>
            <column name="description" value="Başvuru onaylandı"/>
        </insert>
        <insert tableName="application_status">
            <column name="code" value="R"/>
            <column name="name" value="REJECTED"/>
            <column name="description" value="Başvuru reddedildi"/>
        </insert>
        <insert tableName="application_status">
            <column name="code" value="C"/>
            <column name="name" value="CANCELLED"/>
            <column name="description" value="Başvuru iptal edildi"/>
        </insert>
    </changeSet>

</databaseChangeLog>