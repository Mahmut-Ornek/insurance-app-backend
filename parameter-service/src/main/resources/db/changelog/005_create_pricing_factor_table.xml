    <changeSet id="1" author="mahmut">
        <createTable tableName="pricing_factor">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="factor_type" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="min_value" type="decimal(10,2)"/>
            <column name="max_value" type="decimal(10,2)"/>
            <column name="multiplier" type="decimal(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
        </createTable>

        <insert tableName="pricing_factor">
